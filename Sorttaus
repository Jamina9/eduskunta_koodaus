        choice = input("Valitse toiminto (0–10): ").strip()
        if choice == "0":
            break
        elif choice == "1":
            run_custom_filter(members)
        elif choice == "2":
            print_members(sort_members(members, sort_by="ika", descending=False))
        elif choice == "3":
            print_members(sort_members(members, sort_by="ika", descending=True))
        elif choice == "4":
            print_members(sort_members(members, sort_by="sukupuoli", descending=False))
        elif choice == "5":
            available = sorted({m["vaalipiiri"].replace(" vaalipiiri", "") for m in members if m.get("vaalipiiri")})
            print(f"Vaalipiirit: {', '.join(available)}")
            q = input("Anna vaalipiirin osa (esim. pirkanmaan, uudenmaan): ").strip()
            filtered = filter_members(members, districts=q.split(","))
            print_members(sort_members(filtered, sort_by="ika"))
        elif choice == "6":
            q = input("Anna tutkinto tai oppilaitos (esim. maisteri, aalto, tohtori): ").strip()
            filtered = filter_members(members, education_query=q)
            print_members(sort_members(filtered, sort_by="ika"))
        elif choice == "7":
            q = input("Anna ammatti (esim. lääkäri, yrittäjä, poliisi, opettaja): ").strip()
            filtered = filter_members(members, occupation_query=q)
            print_members(sort_members(filtered, sort_by="ika"))
        elif choice == "8":
            filtered = filter_members(members, minister=True)
            print_members(sort_members(filtered, sort_by="ika"))
        elif choice == "9":
            q = input("Anna edustajan nimen osa: ").strip()
            filtered = filter_members(members, name_query=q)
            if filtered:
                print_member_details(sort_members(filtered, sort_by="sukunimi"))
            else:
                print("Ei osumia.")
        elif choice == "10":
            members = enrich_seating_data()
        else:
            print("Tuntematon valinta, yritä uudelleen.")


def load_or_enrich() -> list[dict]:
    if OUTPUT_FILE.exists():
        members = json.loads(OUTPUT_FILE.read_text(encoding="utf-8"))
        if members and REQUIRED_ENRICHED_KEYS.issubset(members[0].keys()):
            print(f"Ladataan data tiedostosta {OUTPUT_FILE}...")
            return members
        print("Vanha rikastettu tiedosto puuttuu uusista kentistä – päivitetään tiedot Wikidatasta...")
    return enrich_seating_data()


def main() -> None:
    members = load_or_enrich()
    interactive_cli(members)


if __name__ == "__main__":
    main()
